generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model about_us {
  id               Int     @id @default(autoincrement())
  tagline          String? @db.VarChar(255)
  est              String? @db.VarChar(15)
  happy_icon       String? @db.VarChar(30)
  happy_client     Int?
  projects_icon    String? @db.VarChar(30)
  project_nos      Int?
  support_icon     String? @db.VarChar(30)
  hrs_support      Int?
  emp_icon         String? @db.VarChar(30)
  emp_nos          Int?
  story_title      String? @db.VarChar(50)
  story_body       String? @db.Text
  story_body2      String? @db.VarChar(255)
  mission_title    String? @db.VarChar(50)
  mission_body     String? @db.Text
  vision_title     String? @db.VarChar(50)
  vision_body      String? @db.Text
  values_title     String? @db.VarChar(50)
  values_body      Int?
  team_title       String? @db.VarChar(30)
  team_description String? @db.VarChar(500)
}

model career {
  id               Int       @id @default(autoincrement())
  post             String    @db.VarChar(100)
  location         String?   @db.VarChar(100)
  image            String    @db.VarChar(100)
  vacancy          Int
  emp_status       String    @default("Full-Time") @db.VarChar(50)
  experience       String?   @db.VarChar(100)
  salary           String    @default("Negotiable") @db.VarChar(25)
  gender           String?   @db.VarChar(10)
  deadline         DateTime? @db.Date
  description      String    @db.Text
  responsibilities String    @db.Text
  Edu_Qlty         String    @db.VarChar(255)
  other_beninifs   String?   @db.Text
  published        DateTime  @db.Date
  status           String?   @db.VarChar(15)
}

model category {
  id                 Int                  @id @default(autoincrement())
  name               String?              @db.VarChar(50)
  project_categories project_categories[]
}

model clients {
  id          Int     @id @default(autoincrement())
  client_name String  @db.VarChar(255)
  logo        String? @db.VarChar(255)
  country     String? @db.VarChar(50)
  email       String? @db.VarChar(100)
  phone       String? @db.VarChar(15)
  location    String? @db.VarChar(255)
  client_cat  Int?
}

model contact {
  id            Int     @id @default(autoincrement())
  sec_title     String  @db.VarChar(30)
  company_title String? @db.VarChar(255)
  address       String  @db.Text
  phone         String? @db.VarChar(15)
  cell          String? @db.VarChar(15)
  email         String  @db.VarChar(100)
  email2        String? @db.VarChar(100)
  lat           String? @db.VarChar(15)
  lon           String? @db.VarChar(15)
  map           String? @db.VarChar(1000)
}

model homepage {
  id                 Int     @id @default(autoincrement())
  logo               String? @db.VarChar(100)
  favicon            String? @db.VarChar(100)
  theme              String? @default("theme-default") @db.VarChar(50)
  bgslide_img        String? @db.VarChar(255)
  company_title      String? @db.VarChar(255)
  slogan             String? @db.VarChar(255)
  glance_title       String? @db.VarChar(255)
  glance_description String? @db.Text
  glance_img         String? @db.VarChar(255)
  Exp_title          String? @db.VarChar(50)
  exp_year           String? @db.VarChar(10)
  pro_title          String  @db.VarChar(50)
  pro_nos            String  @db.VarChar(10)
  title1             String? @db.VarChar(100)
  tag1               String? @db.Text
  title2             String? @db.VarChar(100)
  tag2               String? @db.Text
  title3             String? @db.VarChar(100)
  tag3               String? @db.Text
  title4             String? @db.VarChar(100)
  tag4               String? @db.Text
  title5             String? @db.VarChar(100)
  tag5               String? @db.Text
  title6             String? @db.VarChar(100)
  tag6               String? @db.Text
  title7             String? @db.VarChar(100)
  content7           String? @db.VarChar(1000)
  image7             String? @db.VarChar(100)
  title8             String? @db.VarChar(100)
  content8           String? @db.VarChar(1000)
  image8             String? @db.VarChar(100)
  title9             String? @db.VarChar(50)
  content9           String? @db.VarChar(1000)
  image9             String? @db.VarChar(100)
}

model messages {
  id             Int               @id @default(autoincrement())
  name           String            @db.VarChar(50)
  email          String            @db.VarChar(100)
  company        String            @db.VarChar(100)
  subject        String            @db.VarChar(100)
  message        String            @db.Text
  status         Int               @default(0)
  date           DateTime          @default(now()) @db.Timestamp(0)
  message_cat_id Int?
  category       message_category? @relation(fields: [message_cat_id], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_messages_category")

  @@index([message_cat_id])
}

model message_category {
  id       Int        @id @default(autoincrement())
  name     String?    @map("category_name") @db.VarChar(50)
  active   Boolean    @default(true)
  messages messages[]
}

model pages {
  id        Int     @id @default(autoincrement())
  title     String? @db.VarChar(15)
  page_link String? @db.VarChar(50)
}

model post_category {
  id   Int     @id @default(autoincrement())
  name String? @db.VarChar(30)
}

model posts {
  id         Int      @id @default(autoincrement())
  post_catid Int
  title      String   @db.VarChar(255)
  content    String?  @db.Text
  image      String?  @db.VarChar(255)
  author     String?  @db.VarChar(50)
  sdate      String?  @db.VarChar(50)
  date       DateTime @default(now()) @db.Timestamp(0)

  @@index([post_catid])
}

model pro_sector {
  id        Int    @id @default(autoincrement())
  sec_title String @db.VarChar(100)
}

model projects {
  id                 Int                  @id @default(autoincrement())
  sector_id          Int
  client_id          Int?
  title              String?              @db.VarChar(255)
  images             String?              @db.VarChar(100)
  description        String               @db.Text
  status             String               @default("Completed") @db.VarChar(10)
  show_status        String?              @db.VarChar(100)
  services           String?              @db.Text
  project_cost       String?              @db.VarChar(20)
  service_cost       String?              @db.VarChar(20)
  location           String?              @db.VarChar(100)
  feature            String               @db.VarChar(255)
  story              String?              @db.VarChar(20)
  area               String?              @db.VarChar(50)
  height             String?              @db.VarChar(25)
  sectors            sectors              @relation(fields: [sector_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_projects_sectors")
  project_categories project_categories[]

  @@index([sector_id])
  @@index([client_id])
}

model sectors {
  id       Int        @id @default(autoincrement())
  sector   String?    @db.VarChar(50)
  projects projects[]
}

model services {
  id                Int     @id @default(autoincrement())
  name              String? @db.VarChar(255)
  icon              String? @db.VarChar(100)
  short_description String? @db.Text
  image             String? @db.VarChar(255)
  cont_title        String? @db.VarChar(255)
  description       String? @db.Text
}

model services_child {
  id          Int    @id @default(autoincrement())
  sector_id   Int
  services_id Int
  title       String @db.VarChar(100)

  @@index([sector_id])
  @@index([services_id])
}

model social {
  id   Int     @id @default(autoincrement())
  name String? @db.VarChar(50)
  icon String? @db.VarChar(100)
  link String? @db.VarChar(255)
}

model strength {
  id      Int     @id @default(autoincrement())
  title   String  @db.VarChar(200)
  icon    String  @db.VarChar(50)
  content String? @db.Text
}

model sub_category {
  id          Int     @id @default(autoincrement())
  sec_id      Int
  cat_id      Int
  name        String  @db.VarChar(255)
  description String? @db.Text

  @@index([sec_id])
  @@index([cat_id])
}

model team {
  id            Int     @id @default(autoincrement())
  image         String? @db.VarChar(100)
  name          String? @db.VarChar(50)
  designation   String? @db.VarChar(50)
  message       String? @db.VarChar(500)
  fb            String? @db.VarChar(255)
  insta         String? @db.VarChar(255)
  linkedin      String? @db.VarChar(255)
  fb_link       String? @db.VarChar(100)
  insta_link    String? @db.VarChar(100)
  linkedin_link String? @db.VarChar(100)
  twitter       String? @db.VarChar(255)
}

model testimonials {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(255)
  designation String  @db.VarChar(255)
  company     String? @db.VarChar(50)
  stars       Int     @db.TinyInt
  image       String  @db.VarChar(255)
  story       String  @db.Text
}

model user {
  id       Int      @id @default(autoincrement())
  username String   @db.VarChar(50)
  email    String   @db.VarChar(55)
  password String   @db.VarChar(100)
  image    String?  @db.VarChar(500)
  date     DateTime @default(now()) @db.Timestamp(0)
  role     String   @db.VarChar(10)
}

model project_categories {
  project_id  Int
  category_id Int
  projects    projects @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_proj_cat_project")
  category    category @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_proj_cat_category")

  @@id([project_id, category_id])
  @@index([category_id])
  @@index([project_id])
}
