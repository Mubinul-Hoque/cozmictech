generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model clients {
  id          Int         @id @default(autoincrement())
  client_name String      @db.VarChar(255)
  logo        String?     @db.VarChar(255)
  country     String?     @db.VarChar(100)
  email       String?     @db.VarChar(150)
  phone       String?     @db.VarChar(50)
  location    String?     @db.VarChar(255)
  category_id Int?
  created_at  DateTime    @default(now()) @db.Timestamp(0)
  updated_at  DateTime    @default(now()) @db.Timestamp(0)
  categories  categories? @relation(fields: [category_id], references: [id], onUpdate: Restrict, map: "fk_clients_category")
  projects    projects[]

  @@index([category_id], map: "fk_clients_category")
  @@index([created_at], map: "idx_clients_created_at")
}

model messages {
  id          Int         @id @default(autoincrement())
  category_id Int?
  name        String      @db.VarChar(150)
  email       String      @db.VarChar(150)
  company     String?     @db.VarChar(150)
  subject     String?     @db.VarChar(255)
  message     String      @db.Text
  is_read     Boolean?    @default(false)
  created_at  DateTime    @default(now()) @db.Timestamp(0)
  updated_at  DateTime    @default(now()) @db.Timestamp(0)
  categories  categories? @relation(fields: [category_id], references: [id], onUpdate: Restrict, map: "fk_messages_category")

  @@index([category_id], map: "fk_messages_category")
  @@index([created_at], map: "idx_messages_created_at")
}

model posts {
  id           Int         @id @default(autoincrement())
  category_id  Int?
  title        String      @db.VarChar(255)
  content      String?     @db.Text
  image        String?     @db.VarChar(255)
  author_name  String?     @db.VarChar(100)
  published_at DateTime?   @db.Timestamp(0)
  created_at   DateTime    @default(now()) @db.Timestamp(0)
  updated_at   DateTime    @default(now()) @db.Timestamp(0)
  categories   categories? @relation(fields: [category_id], references: [id], onUpdate: Restrict, map: "fk_posts_category")

  @@index([category_id], map: "fk_posts_category")
  @@index([created_at], map: "idx_posts_created_at")
}

model projects {
  id                      Int                       @id @default(autoincrement())
  sector_id               Int?
  client_id               Int?
  title                   String                    @db.VarChar(255)
  images_json             String?                   @db.LongText
  description             String?                   @db.Text
  status                  ProjectStatus             @default(Completed)
  services_rendered       String?                   @db.Text
  project_cost            String?                   @db.VarChar(100)
  service_cost            String?                   @db.VarChar(100)
  location                String?                   @db.VarChar(255)
  feature                 String?                   @db.VarChar(255)
  story                   String?                   @db.VarChar(100)
  area                    String?                   @db.VarChar(100)
  height                  String?                   @db.VarChar(100)
  start_date              DateTime?                 @db.Date
  end_date                DateTime?                 @db.Date
  created_at              DateTime                  @default(now()) @db.Timestamp(0)
  updated_at              DateTime                  @default(now()) @db.Timestamp(0)
  project_categories_link project_categories_link[]
  client                  clients?                  @relation(fields: [client_id], references: [id], onUpdate: Restrict, map: "fk_projects_client")
  sectors                 sectors?                  @relation(fields: [sector_id], references: [id], onUpdate: Restrict, map: "fk_projects_sectors")

  @@index([client_id], map: "fk_projects_client")
  @@index([sector_id], map: "fk_projects_sector")
  @@index([status], map: "idx_projects_status")
  @@index([created_at], map: "idx_projects_created_at")
}

model sectors {
  id         Int        @id @default(autoincrement())
  name       String     @db.VarChar(100)
  created_at DateTime   @default(now()) @db.Timestamp(0)
  updated_at DateTime   @default(now()) @db.Timestamp(0)
  projects   projects[]
}

model services {
  id                Int      @id @default(autoincrement())
  name              String   @db.VarChar(255)
  icon              String?  @db.VarChar(100)
  image             String?  @db.VarChar(255)
  short_description String?  @db.Text
  description       String?  @db.Text
  created_at        DateTime @default(now()) @db.Timestamp(0)
  updated_at        DateTime @default(now()) @db.Timestamp(0)
}

model testimonials {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(255)
  designation String?  @db.VarChar(255)
  company     String?  @db.VarChar(255)
  stars       Int?     @default(5) @db.TinyInt
  image       String?  @db.VarChar(255)
  story       String   @db.Text
  created_at  DateTime @default(now()) @db.Timestamp(0)
  updated_at  DateTime @default(now()) @db.Timestamp(0)
}

model careers {
  id                Int       @id @default(autoincrement())
  post              String    @db.VarChar(150)
  location          String?   @db.VarChar(150)
  image             String?   @db.VarChar(255)
  vacancy           Int?      @default(1)
  employment_status String?   @default("Full-Time") @db.VarChar(50)
  experience        String?   @db.VarChar(255)
  salary            String?   @default("Negotiable") @db.VarChar(100)
  gender            String?   @default("Any") @db.VarChar(50)
  deadline          DateTime? @db.Date
  description       String?   @db.Text
  responsibilities  String?   @db.Text
  education_quality String?   @db.Text
  other_benefits    String?   @db.Text
  is_active         Boolean?  @default(true)
  created_at        DateTime  @default(now()) @db.Timestamp(0)
  updated_at        DateTime  @default(now()) @db.Timestamp(0)
}

model categories {
  id                      Int                       @id @default(autoincrement())
  name                    String                    @db.VarChar(100)
  type                    String?                   @default("project") @db.VarChar(50)
  created_at              DateTime                  @default(now()) @db.Timestamp(0)
  updated_at              DateTime                  @default(now()) @db.Timestamp(0)
  clients                 clients[]
  messages                messages[]
  posts                   posts[]
  project_categories_link project_categories_link[]
}

model page_sections {
  id              Int      @id @default(autoincrement())
  page_slug       String   @db.VarChar(100)
  section_key     String   @db.VarChar(50)
  title           String?  @db.VarChar(255)
  subtitle_or_tag String?  @db.Text
  content         String?  @db.Text
  image           String?  @db.LongText
  icon            String?  @db.VarChar(100)
  counter_number  String?  @db.VarChar(50)
  sort_order      Int?     @default(0)
  is_active       Boolean? @default(true)
  created_at      DateTime @default(now()) @db.Timestamp(0)
  updated_at      DateTime @default(now()) @db.Timestamp(0)
}

model project_categories_link {
  project_id  Int
  category_id Int
  categories  categories @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_pcl_category")
  projects    projects   @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_pcl_project")

  @@id([project_id, category_id])
  @@index([category_id], map: "fk_pcl_category")
}

model settings {
  setting_key   String   @id @db.VarChar(100)
  setting_group String?  @db.VarChar(50)
  setting_value String?  @db.Text
  updated_at    DateTime @default(now()) @db.Timestamp(0)
}

model social_links {
  id            Int      @id @default(autoincrement())
  platform_name String   @db.VarChar(100)
  icon          String?  @db.VarChar(100)
  url           String   @db.VarChar(255)
  created_at    DateTime @default(now()) @db.Timestamp(0)
  updated_at    DateTime @default(now()) @db.Timestamp(0)
}

model strengths {
  id         Int      @id @default(autoincrement())
  title      String   @db.VarChar(255)
  icon       String?  @db.VarChar(100)
  content    String?  @db.Text
  created_at DateTime @default(now()) @db.Timestamp(0)
  updated_at DateTime @default(now()) @db.Timestamp(0)
}

model team_members {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(100)
  designation   String?  @db.VarChar(100)
  image         String?  @db.VarChar(255)
  message       String?  @db.Text
  facebook_url  String?  @db.VarChar(255)
  instagram_url String?  @db.VarChar(255)
  linkedin_url  String?  @db.VarChar(255)
  twitter_url   String?  @db.VarChar(255)
  created_at    DateTime @default(now()) @db.Timestamp(0)
  updated_at    DateTime @default(now()) @db.Timestamp(0)
}

model users {
  id         Int      @id @default(autoincrement())
  username   String   @db.VarChar(50)
  email      String   @unique(map: "idx_users_email") @db.VarChar(100)
  password   String   @db.VarChar(255)
  image      String?  @db.VarChar(255)
  role       String   @default("Admin") @db.VarChar(50)
  created_at DateTime @default(now()) @db.Timestamp(0)
  updated_at DateTime @default(now()) @db.Timestamp(0)
}

enum ProjectStatus {
  Ongoing
  Completed
}
