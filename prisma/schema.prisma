generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model clients {
  id          Int         @id @default(autoincrement())
  client_name String      @db.VarChar(255)
  logo        String?     @db.VarChar(255)
  country     String?     @db.VarChar(100)
  email       String?     @db.VarChar(150)
  phone       String?     @db.VarChar(50)
  location    String?     @db.VarChar(255)
  category_id Int?
  created_at  DateTime    @default(now()) @db.Timestamp(0)
  updated_at  DateTime    @default(now()) @db.Timestamp(0)
  categories  categories? @relation(fields: [category_id], references: [id], onUpdate: Restrict, map: "fk_clients_category")
  projects    projects[]

  @@index([category_id], map: "fk_clients_category")
  @@index([created_at], map: "idx_clients_created_at")
}

model messages {
  id          Int         @id @default(autoincrement())
  category_id Int?
  name        String      @db.VarChar(150)
  email       String      @db.VarChar(150)
  company     String?     @db.VarChar(150)
  subject     String?     @db.VarChar(255)
  message     String      @db.Text
  is_read     Boolean?    @default(false)
  created_at  DateTime    @default(now()) @db.Timestamp(0)
  updated_at  DateTime    @default(now()) @db.Timestamp(0)
  categories  categories? @relation(fields: [category_id], references: [id], onUpdate: Restrict, map: "fk_messages_category")

  @@index([category_id], map: "fk_messages_category")
  @@index([created_at], map: "idx_messages_created_at")
}

model posts {
  id           Int         @id @default(autoincrement())
  category_id  Int?
  title        String      @db.VarChar(255)
  content      String?     @db.Text
  image        String?     @db.VarChar(255)
  author_name  String?     @db.VarChar(100)
  published_at DateTime?   @db.Timestamp(0)
  created_at   DateTime    @default(now()) @db.Timestamp(0)
  updated_at   DateTime    @default(now()) @db.Timestamp(0)
  categories   categories? @relation(fields: [category_id], references: [id], onUpdate: Restrict, map: "fk_posts_category")

  @@index([category_id], map: "fk_posts_category")
  @@index([created_at], map: "idx_posts_created_at")
  @@index([published_at], map: "idx_posts_published_at")
}

model projects {
  id                      Int                       @id @default(autoincrement())
  sector_id               Int?
  client_id               Int?
  title                   String                    @db.VarChar(255)
  images_json             String?                   @db.LongText
  description             String?                   @db.Text
  status                  ProjectStatus             @default(Completed)
  services_rendered       String?                   @db.Text
  project_cost            String?                   @db.VarChar(100)
  service_cost            String?                   @db.VarChar(100)
  location                String?                   @db.VarChar(255)
  specifications_json     String?                   @db.LongText
  services_json           String?                   @db.LongText
  start_date              DateTime?                 @db.Date
  end_date                DateTime?                 @db.Date
  created_at              DateTime                  @default(now()) @db.Timestamp(0)
  updated_at              DateTime                  @default(now()) @db.Timestamp(0)
  project_categories_link project_categories_link[]
  client                  clients?                  @relation(fields: [client_id], references: [id], onUpdate: Restrict, map: "fk_projects_client")
  sectors                 sectors?                  @relation(fields: [sector_id], references: [id], onUpdate: Restrict, map: "fk_projects_sectors")

  @@index([client_id], map: "fk_projects_client")
  @@index([sector_id], map: "fk_projects_sector")
  @@index([status], map: "idx_projects_status")
  @@index([created_at], map: "idx_projects_created_at")
  @@index([start_date], map: "idx_projects_start_date")
  @@index([end_date], map: "idx_projects_end_date")
  @@index([title], map: "idx_projects_title")
}

model sectors {
  id         Int        @id @default(autoincrement())
  name       String     @db.VarChar(100)
  created_at DateTime   @default(now()) @db.Timestamp(0)
  updated_at DateTime   @default(now()) @db.Timestamp(0)
  projects   projects[]

  @@index([name], map: "idx_sectors_name")
}

model services {
  id                Int      @id @default(autoincrement())
  name              String   @db.VarChar(255)
  icon              String?  @db.VarChar(100)
  image             String?  @db.VarChar(255)
  short_description String?  @db.Text
  description       String?  @db.Text
  created_at        DateTime @default(now()) @db.Timestamp(0)
  updated_at        DateTime @default(now()) @db.Timestamp(0)

  @@index([name], map: "idx_services_name")
}

model testimonials {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(255)
  designation String?  @db.VarChar(255)
  company     String?  @db.VarChar(255)
  stars       Int?     @default(5) @db.TinyInt
  image       String?  @db.VarChar(255)
  story       String   @db.Text
  created_at  DateTime @default(now()) @db.Timestamp(0)
  updated_at  DateTime @default(now()) @db.Timestamp(0)
}

model careers {
  id                Int       @id @default(autoincrement())
  post              String    @db.VarChar(150)
  location          String?   @db.VarChar(150)
  image             String?   @db.VarChar(255)
  vacancy           Int?      @default(1)
  employment_status String?   @default("Full-Time") @db.VarChar(50)
  experience        String?   @db.VarChar(255)
  salary            String?   @default("Negotiable") @db.VarChar(100)
  gender            String?   @default("Any") @db.VarChar(50)
  deadline          DateTime? @db.Date
  description       String?   @db.Text
  responsibilities  String?   @db.Text
  education_quality String?   @db.Text
  other_benefits    String?   @db.Text
  is_active         Boolean?  @default(true)
  created_at        DateTime  @default(now()) @db.Timestamp(0)
  updated_at        DateTime  @default(now()) @db.Timestamp(0)

  @@index([is_active], map: "idx_careers_is_active")
  @@index([created_at], map: "idx_careers_created_at")
}

model categories {
  id                      Int                       @id @default(autoincrement())
  name                    String                    @db.VarChar(100)
  type                    String?                   @default("project") @db.VarChar(50)
  created_at              DateTime                  @default(now()) @db.Timestamp(0)
  updated_at              DateTime                  @default(now()) @db.Timestamp(0)
  clients                 clients[]
  messages                messages[]
  posts                   posts[]
  project_categories_link project_categories_link[]

  @@index([name], map: "idx_categories_name")
  @@index([type], map: "idx_categories_type")
}

model page_sections {
  id              Int      @id @default(autoincrement())
  page_slug       String   @db.VarChar(100)
  section_key     String   @db.VarChar(50)
  title           String?  @db.VarChar(255)
  subtitle_or_tag String?  @db.Text
  content         String?  @db.Text
  image           String?  @db.LongText
  icon            String?  @db.VarChar(100)
  counter_number  String?  @db.VarChar(50)
  sort_order      Int?     @default(0)
  is_active       Boolean? @default(true)
  created_at      DateTime @default(now()) @db.Timestamp(0)
  updated_at      DateTime @default(now()) @db.Timestamp(0)

  @@index([page_slug, section_key], map: "idx_page_sec_slug_key")
  @@index([page_slug], map: "idx_page_sec_slug")
}

model project_categories_link {
  project_id  Int
  category_id Int
  categories  categories @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_pcl_category")
  projects    projects   @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_pcl_project")

  @@id([project_id, category_id])
  @@index([category_id], map: "fk_pcl_category")
}

model settings {
  setting_key   String   @id @db.VarChar(100)
  setting_group String?  @db.VarChar(50)
  setting_value String?  @db.Text
  updated_at    DateTime @default(now()) @db.Timestamp(0)
}

model page_views {
  id           Int      @id @default(autoincrement())
  page_path    String   @db.VarChar(500)
  page_title   String?  @db.VarChar(255)
  referrer     String?  @db.VarChar(500)
  country_code String?  @db.VarChar(10)
  country_name String?  @db.VarChar(100)
  device_type  String?  @db.VarChar(20)
  source       String?  @db.VarChar(50)
  keyword      String?  @db.VarChar(255)
  sector_id    Int?
  category_id  Int?
  project_id   Int?
  visited_at   DateTime @default(now()) @db.Timestamp(0)

  @@index([visited_at], map: "idx_pv_visited_at")
  @@index([page_path], map: "idx_pv_page_path")
  @@index([country_code], map: "idx_pv_country")
  @@index([device_type], map: "idx_pv_device")
  @@index([source], map: "idx_pv_source")
}

model social_links {
  id            Int      @id @default(autoincrement())
  platform_name String   @db.VarChar(100)
  icon          String?  @db.VarChar(100)
  url           String   @db.VarChar(255)
  created_at    DateTime @default(now()) @db.Timestamp(0)
  updated_at    DateTime @default(now()) @db.Timestamp(0)
}

model strengths {
  id         Int      @id @default(autoincrement())
  title      String   @db.VarChar(255)
  icon       String?  @db.VarChar(100)
  content    String?  @db.Text
  created_at DateTime @default(now()) @db.Timestamp(0)
  updated_at DateTime @default(now()) @db.Timestamp(0)
}

model team_members {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(100)
  designation   String?  @db.VarChar(100)
  image         String?  @db.VarChar(255)
  message       String?  @db.Text
  facebook_url  String?  @db.VarChar(255)
  instagram_url String?  @db.VarChar(255)
  linkedin_url  String?  @db.VarChar(255)
  twitter_url   String?  @db.VarChar(255)
  created_at    DateTime @default(now()) @db.Timestamp(0)
  updated_at    DateTime @default(now()) @db.Timestamp(0)
}

model users {
  id         Int       @id @default(autoincrement())
  username   String    @db.VarChar(50)
  email      String    @unique(map: "idx_users_email") @db.VarChar(100)
  password   String    @db.VarChar(255)
  image      String?   @db.VarChar(255)
  role       String    @default("Admin") @db.VarChar(50)
  role_id    Int?
  is_active  Boolean   @default(true)
  created_at DateTime  @default(now()) @db.Timestamp(0)
  updated_at DateTime  @default(now()) @db.Timestamp(0)
  roles      roles?    @relation(fields: [role_id], references: [id], onUpdate: Restrict, map: "fk_users_role")

  @@index([role_id], map: "fk_users_role")
}

model roles {
  id          Int                @id @default(autoincrement())
  name        String             @unique(map: "idx_roles_name") @db.VarChar(100)
  description String?            @db.Text
  is_system   Boolean            @default(false)
  created_at  DateTime           @default(now()) @db.Timestamp(0)
  updated_at  DateTime           @default(now()) @db.Timestamp(0)
  users       users[]
  permissions role_permissions[]
}

model role_permissions {
  id         Int      @id @default(autoincrement())
  role_id    Int
  module     String   @db.VarChar(100)
  action     String   @db.VarChar(50)
  created_at DateTime @default(now()) @db.Timestamp(0)
  roles      roles    @relation(fields: [role_id], references: [id], onDelete: Cascade, map: "fk_role_permissions_role")

  @@unique([role_id, module, action], map: "idx_role_perm_unique")
  @@index([role_id], map: "fk_role_permissions_role")
  @@index([module], map: "idx_role_perm_module")
}

enum ProjectStatus {
  Ongoing
  Completed
}

model security_logs {
  id          Int      @id @default(autoincrement())
  action      String   @db.VarChar(100)
  identifier  String?  @db.VarChar(150)
  user_id     Int?
  ip_address  String?  @db.VarChar(100)
  user_agent  String?  @db.VarChar(500)
  device_type String?  @db.VarChar(50)
  severity    String   @default("info") @db.VarChar(20)
  details     String?  @db.Text
  created_at  DateTime @default(now()) @db.Timestamp(0)

  @@index([created_at], map: "idx_seclog_created_at")
  @@index([ip_address], map: "idx_seclog_ip")
  @@index([action], map: "idx_seclog_action")
  @@index([severity], map: "idx_seclog_severity")
}

model blocked_ips {
  id         Int      @id @default(autoincrement())
  ip_address String   @unique(map: "idx_blocked_ips_ip") @db.VarChar(100)
  reason     String?  @db.VarChar(255)
  blocked_by String?  @db.VarChar(100)
  created_at DateTime @default(now()) @db.Timestamp(0)

  @@index([ip_address], map: "idx_bip_ip")
}
